# Beacon.ai Environment Variables Configuration

# Google Gemini API Key (Server-side AI analysis & evacuation advisories)
GEMINI_API_KEY=

# NASA FIRMS API Key for live satellite wildfire hotspots (Get free at https://firms.modaps.eosdis.nasa.gov/api/)
FIRMS_API_KEY=

# GeoAI Microservice URL (Optional Python AI service, defaults to Node.js fallbacks)
GEOAI_SERVICE_URL=http://127.0.0.1:8001

# Supabase Auth & Database (Get from https://supabase.com dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
